# Copy to .env and fill in. Never commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jobapply
MYSQL_USER=jobapply
MYSQL_PASSWORD=change-me
# Backend connection string (compose overrides host to "mysql")
DATABASE_URL=mysql+pymysql://jobapply:change-me@localhost:3306/jobapply

# --- Auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- Encryption for site credentials / storage_state ---
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- AI provider (resume parsing, job scoring, form-field mapping) ---
# gemini  = Google Gemini free tier  (key: https://aistudio.google.com/apikey)      <- default
# groq    = Groq free tier           (key: https://console.groq.com/keys)
# ollama  = local model on your PC   (install https://ollama.com, then: ollama pull qwen2.5:7b)
# anthropic = Claude API (paid; separate from a Claude Pro subscription)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage

# --- Browser automation (worker, run on your own machine) ---
# Headless runs are more likely to be flagged by sites; set false to watch the browser.
# Your country's Indeed domain, e.g. https://www.indeed.com or https://in.indeed.com
INDEED_BASE_URL=https://in.indeed.com
PLAYWRIGHT_HEADLESS=true
# Optional: path to Chrome/Chromium if you do not use `playwright install chromium`
PLAYWRIGHT_EXECUTABLE=
# Random pause (seconds) between application attempts per account
APPLY_GAP_MIN_S=20
APPLY_GAP_MAX_S=60
