# Copy to .env and fill in. Never commit .env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jobapply
MYSQL_USER=jobapply
MYSQL_PASSWORD=change-me
# Backend connection string (compose overrides host to "mysql")
DATABASE_URL=mysql+pymysql://jobapply:change-me@localhost:3306/jobapply

# --- Auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- Encryption for site credentials / storage_state ---
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Anthropic (used from milestone 2 on) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
